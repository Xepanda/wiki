# ==============================================================================
# AI & 开发环境敏感配置模板 (env.template)
# 使用方法:
#   1. 复制本文件为 ~/.ai_env: cp scripts/env.template ~/.ai_env
#   2. 填入实际的 API Key、Token 与私有连接串
#   3. 在 ~/.zshrc 或 ~/.bashrc 中 source ~/.ai_env
#   *注意*: 本模板严格不包含任何真实明文密钥，可安全纳入版本管理。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 大模型与 AI 平台 API Keys
# ------------------------------------------------------------------------------
# 智谱 BigModel API Key (用于 web-reader, web-search-prime, zread 等 MCP 联网检索服务)
export ZHIPU_API_KEY="${ZHIPU_API_KEY:-your_zhipu_api_key_here}"

# Z.AI 平台 API Key (用于 @z_ai/mcp-server)
export Z_AI_API_KEY="${Z_AI_API_KEY:-your_z_ai_api_key_here}"

# OpenAI / LongCat API Key (用于 Codex CLI 自定义 Provider 或通用 OpenAI 接口)
export OPENAI_API_KEY="${OPENAI_API_KEY:-your_openai_or_longcat_key_here}"

# Anthropic Claude 官方 API Key (按需)
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-your_anthropic_key_here}"

# ------------------------------------------------------------------------------
# 2. 内部业务与物联网平台凭证
# ------------------------------------------------------------------------------
# 涂鸦 AI 网关 / 开发平台 API Key
export TUYA_AI_GATEWAY_API_KEY="${TUYA_AI_GATEWAY_API_KEY:-your_tuya_gateway_key_here}"

# Google Cloud Project ID (按需)
export GOOGLE_CLOUD_PROJECT="${GOOGLE_CLOUD_PROJECT:-your_google_cloud_project_id_here}"

# ------------------------------------------------------------------------------
# 3. 运行环境行为开关
# ------------------------------------------------------------------------------
# 启用 Claude Code 工具检索优化
export ENABLE_TOOL_SEARCH="true"

# 统一编码与语言
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"
